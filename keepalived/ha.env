# /etc/keepalived/ha.env
#
# The only file that differs between the two machines. Everything else
# under /etc/keepalived/ (the notify scripts) is identical on both nodes.
#
# On the MASTER node, set PEER_REAL_IP to the SLAVE's real IP.
# On the SLAVE node,  set PEER_REAL_IP to the MASTER's real IP.
# "Real IP" = the machine's own normal address, NOT the VIP.

PEER_REAL_IP="192.168.195.4"

MANAGER_DIR="/home/shriraksha/ha-project/orchestrator/manager"

MANAGER_DB_PATH="/home/shriraksha/ha-project/orchestrator/manager/manager_state.db"

DB_SYNC_INTERVAL=5

SSH_USER="shriraksha"

LOG="/home/shriraksha/ha-project/orchestrator/orchestrator.log"
